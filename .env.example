# Copy to .env and fill in. Never commit .env.

# ===== Server =====
# development | production
NODE_ENV=development
PORT=3009

# ===== URLs =====
# Public base URL of this API; prefixed to uploaded file paths
CLIENT_URL=http://localhost:3009/
FRONTEND_URL=http://localhost:3000

# ===== Auth =====
# Required in production. Generate: openssl rand -hex 32
JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_IN=7d
SECRET=change-me-long-random-string

# ===== Database (PostgreSQL) =====
DB_HOST=localhost
DB_NAME=himza_music
DB_USERNAME=postgres
DB_PASSWORD=your_db_password

# ===== Socket.IO =====
SOCKET_PATH=/socket.io

# ===== Login methods (true | false) =====
# Note: the code reads ALLLOW_ (three L's)
ALLLOW_LOGIN_BY_EMAIL=true
ALLLOW_LOGIN_BY_MOBILE=true
ALLLOW_LOGIN_BY_GOOGLE=true
ALLLOW_LOGIN_BY_APPLE=true

# ===== Social login =====
# Comma-separated. Google login is refused if empty
GOOGLE_CLIENT_IDS=android-id.apps.googleusercontent.com,ios-id.apps.googleusercontent.com
# Comma-separated bundle / services ids. Apple login is refused if empty
APPLE_CLIENT_IDS=com.example.app

# ===== Email (OTP) =====
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=you@example.com
# Gmail: use an App Password
EMAIL_PASSWORD=your_app_password

# ===== SMS OTP: Twilio =====
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+10000000000

# ===== SMS OTP: MSG91 =====
MSG91_API_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_template_id
MSG91_SENDER_ID=your_sender_id
MSG91_API_ENDPOINT=https://api.msg91.com/api/v5/otp

# ===== Payments =====
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# Live: https://api-m.paypal.com
PAYPAL_API=https://api-m.sandbox.paypal.com

# ===== Push notifications: OneSignal =====
ONE_SIGNAL_APP_ID=your_onesignal_app_id
ONE_SIGNAL_API_KEY=your_onesignal_rest_api_key
ANDROID_CHANNEL_ID=your_android_channel_id
ONE_SIGNAL_APP_ID_BUSINESS=your_business_app_id
ONE_SIGNAL_API_KEY_BUSINESS=your_business_rest_api_key
ANDROID_CHANNEL_ID_BUSINESS=your_business_android_channel_id

# ===== Written by the admin panel =====
PURCHASE_CODE=your_purchase_code
